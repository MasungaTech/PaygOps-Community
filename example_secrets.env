# EVERYTHING IN HERE SHOULD BE CHANGED IN PRODUCTION
# Those should be identical
POSTGRES_USER=solaris_deploy
PG_USER=solaris_deploy
# Those should be identical
POSTGRES_PASSWORD=solaris
PG_PASSWORD=solaris

# Optional: override PostgreSQL database names (defaults: main_db, sms_db, accounting_db, audit_db)
# MAIN_DB_NAME also falls back to POSTGRES_DB when unset (Docker postgres image uses POSTGRES_DB).
# MAIN_DB_NAME=main_db
# SMS_DB_NAME=sms_db
# ACCOUNTING_DB_NAME=accounting_db
# AUDIT_DB_NAME=audit_db

ENV_VAR=DEV
PAYG_URL=localhost:8000
SECRET_KEY=change-me-in-production


INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme123

# Must be set for the password recovery emails and other emails to work
SENDER_EMAIL=donotreply@example.com
EMAIL_SERVER_URL=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

